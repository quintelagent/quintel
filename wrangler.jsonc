{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quintel",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "quintelagent.com", "custom_domain": true },
    { "pattern": "www.quintelagent.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quintel",
      "database_id": "4a505724-4bbb-4bb2-93d7-705f1ca51161",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "SYMBOL": "NVDA",
    "CHAIN_ID": "4663",
    "CHAIN_EXPLORER": "https://robinhoodchain.blockscout.com",
    "NVDA_TOKEN_ADDRESS": "0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC",
    "NVDA_POOL_ADDRESS": "0xd4EB21209C4D6093f80B5b84f5C45cc093EA14a3",
    "TRIAGE_MODEL": "anthropic/claude-haiku-5.5",
    "BRIEFING_MODEL": "google/gemini-3.8-flash",
    "AI_DAILY_CAP_USD": "4",
    "PRE_CRISIS_LEVEL": "0",
    "LAUNCH_AT": "",
    "HEARING_DATE": "2026-12-01",
    "HEARING_LABEL": "Reported House committee session",
    "HEARING_URL": "https://www.axios.com/2026/11/17/nvidia-jensen-huang-congress-testify-dates",
    "EVENT_DATE": "2026-11-23",
    "BACK_ABOVE_LEVEL": "186.64",
    "QNTL_TOKEN_PONS": "0x6997C0690DDE8e0d08e4D20A562f5d2817b54c5F",
    "QNTL_TOKEN_SOLANA": "",
    "BURN_AMOUNT": "100000",
    "SITE_URL": "https://quintelagent.com",
    "FINGERPRINT_ADDRESS": "0xdF2E620aa0A91F23C39eD31345CD0a548E02bB47"
  }
}
